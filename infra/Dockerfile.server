# syntax=docker/dockerfile:1.7
# ---- build -----------------------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/protocol/package.json packages/protocol/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY e2e/package.json e2e/
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY tsconfig.base.json ./
COPY packages/protocol packages/protocol
COPY apps/server apps/server
RUN npm run build -w packages/protocol && npm run build -w apps/server \
 && npm prune --omit=dev --workspace apps/server --workspace packages/protocol

# ---- runtime ---------------------------------------------------------------------------------
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/node_modules node_modules
COPY --from=build --chown=app:app /app/package.json package.json
COPY --from=build --chown=app:app /app/packages/protocol/package.json packages/protocol/package.json
COPY --from=build --chown=app:app /app/packages/protocol/dist packages/protocol/dist
COPY --from=build --chown=app:app /app/apps/server/package.json apps/server/package.json
COPY --from=build --chown=app:app /app/apps/server/dist apps/server/dist
COPY --from=build --chown=app:app /app/apps/server/migrations apps/server/migrations
USER app
WORKDIR /app/apps/server
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["node", "dist/index.js"]
