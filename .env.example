# ---- Server (apps/server) ----------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API / open the WebSocket.
PUBLIC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only behind a reverse proxy that sets X-Forwarded-For (nginx config in infra/ does).
TRUST_PROXY=false

REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://localhost:5432/stranger

# 32+ random bytes, hex. Used to HMAC client ids and IP addresses before storage. Rotating it
# invalidates existing blocks/bans keyed by hashed identity.   openssl rand -hex 32
IDENTITY_SECRET=replace-with-openssl-rand-hex-32
# Leave empty to disable the admin API entirely.               openssl rand -hex 32
ADMIN_TOKEN=

# ICE servers handed to browsers. STUN is enough on most home networks; TURN is required for
# symmetric NAT / corporate networks and is a paid or self-hosted service (see docs/EXTERNAL-SERVICES.md).
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# coturn `static-auth-secret`; credentials are minted per request and expire after TURN_TTL_SECONDS.
TURN_SECRET=
# Or static credentials from a hosted TURN provider (e.g. Metered Open Relay free tier) instead of a secret.
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=600

# Matchmaking: wait this long for an interest match before accepting anyone in the same mode.
MATCH_FALLBACK_MS=8000
# After "Next", skip the previous partner for this long while other people are waiting.
MATCH_REMATCH_GRACE_MS=20000
MAX_CONNECTIONS_PER_IP=6
MAX_MESSAGE_LENGTH=2000

# Moderation
REPORT_AUTOBAN_THRESHOLD=3
REPORT_AUTOBAN_WINDOW_HOURS=24
AUTOBAN_DURATION_HOURS=24
REPORT_RETENTION_DAYS=90

# Single-service hosting: serve the built web app (apps/web/dist) from the API process. Leave empty
# when nginx or a static host serves the SPA.
STATIC_DIR=
# Public site URL; its origin is added to PUBLIC_ORIGINS and used for canonical links.
SITE_URL=

# ---- Web (apps/web) — read at build time by Vite ---------------------------------------
# Leave empty to use the same origin as the page (production behind nginx). For local dev the
# Vite dev server proxies /api and /ws to http://localhost:8080.
# VITE_SITE_URL is the public origin only (https://example.com); VITE_BASE is the path prefix when the
# site lives under a sub-path (e.g. /stranger/ on GitHub Pages). Both are read at build time.
VITE_API_BASE=
VITE_WS_URL=
